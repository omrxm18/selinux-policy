allow tailscaled_t file_context_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t firewalld_etc_rw_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t geoclue_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t geoclue_etc_t:file getattr;
allow tailscaled_t httpd_config_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t lvm_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t lvm_metadata_t:dir { getattr open read watch watch_reads };
allow tailscaled_t modules_conf_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t net_conf_t:dir { watch watch_reads };
allow tailscaled_t policy_config_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t pppd_etc_rw_t:dir { getattr open read watch watch_reads };
allow tailscaled_t pppd_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t samba_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t saslauthd_keytab_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t selinux_config_t:dir { read watch watch_reads };
allow tailscaled_t system_cron_spool_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t systemd_unit_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t systemd_user_unit_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t tls_privkey_t:dir { getattr open read watch watch_reads };
allow tailscaled_t tor_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t tor_etc_t:file getattr;
allow tailscaled_t udev_rules_t:dir { getattr open read watch watch_reads };
allow tailscaled_t unreserved_port_t:tcp_socket name_bind;
allow tailscaled_t virt_etc_rw_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t virt_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t wireguard_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t wireguard_etc_t:file getattr;
allow tailscaled_t NetworkManager_t:dbus send_msg;
allow tailscaled_t kernel_t:system module_request;
allow tailscaled_t kmod_exec_t:file { read open execute };

