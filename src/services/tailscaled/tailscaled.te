policy_module(tailscaled, 1.0)

gen_require(`
    type staff_t;
    type system_cron_spool_t;
    type saslauthd_keytab_t;
    type NetworkManager_etc_rw_t;
    type tls_privkey_t;
    type lvm_etc_t;
    type initrc_t;
    type selinux_config_t;
    type geoclue_etc_t;
    type container_config_t;
    type wireguard_etc_t;
    type etc_t;
    type cert_t;
    type dbusd_etc_t;
    type exports_t;
    type modules_conf_t;
    type unreserved_port_t;
    type pppd_etc_t;
    type default_context_t;
    type file_context_t;
    type systemd_user_unit_t;
    type NetworkManager_etc_t;
    type httpd_config_t;
    type tor_etc_t;
    type systemd_unit_t;
    type policy_config_t;
    type bin_t;
    type alsa_etc_t;
    type firewalld_etc_rw_t;
    type cupsd_rw_etc_t;
    type virt_etc_t;
    type udev_rules_t;
    type cgroup_t;
    type auditd_etc_t;
    type virt_etc_rw_t;
    type bluetooth_conf_t;
    type lvm_metadata_t;
    type net_conf_t;
    type cupsd_etc_t;
    type pppd_etc_rw_t;
    type samba_etc_t;
    type NetworkManager_t;
    type kmod_exec_t;
    type kernel_t;

    class netlink_netfilter_socket { bind create getopt read write };
    class tun_socket { relabelfrom relabelto };
    class process getsched;
    class fifo_file read;
    class system module_request;
    class netlink_generic_socket { bind create getattr getopt read setopt write };
    class file { getattr open read execute execute_no_trans };
    class dir { getattr open read search watch watch_reads };
    class dbus send_msg;
    class rawip_socket create;
    class fifo_file { getattr write };
    class sock_file getattr;
    class tcp_socket name_bind;
')

type tailscaled_t;
type tailscaled_exec_t;
init_daemon_domain(tailscaled_t, tailscaled_exec_t)

type tailscaled_runtime_t;
files_type(tailscaled_runtime_t)

type tailscaled_var_lib_t;
files_type(tailscaled_var_lib_t)

allow tailscaled_t self:capability { net_admin net_raw net_bind_service };
allow tailscaled_t self:process { signal_perms getsched };
allow tailscaled_t self:unix_stream_socket create_stream_socket_perms;
allow tailscaled_t self:unix_dgram_socket create_socket_perms;
allow tailscaled_t self:tcp_socket create_stream_socket_perms;
allow tailscaled_t self:udp_socket create_socket_perms;
allow tailscaled_t self:tun_socket create_socket_perms;
allow tailscaled_t self:netlink_route_socket create_netlink_socket_perms;
allow tailscaled_t self:netlink_netfilter_socket create_socket_perms;
allow tailscaled_t self:netlink_generic_socket { bind create getattr getopt read setopt write };
allow tailscaled_t self:fifo_file { getattr write read };
allow tailscaled_t self:rawip_socket create;

manage_dirs_pattern(tailscaled_t, tailscaled_runtime_t, tailscaled_runtime_t)
manage_sock_files_pattern(tailscaled_t, tailscaled_runtime_t, tailscaled_runtime_t)
manage_dirs_pattern(tailscaled_t, tailscaled_var_lib_t, tailscaled_var_lib_t)
manage_files_pattern(tailscaled_t, tailscaled_var_lib_t, tailscaled_var_lib_t)

corenet_rw_tun_tap_dev(tailscaled_t)
logging_send_syslog_msg(tailscaled_t)
miscfiles_read_localization(tailscaled_t)
sysnet_dns_name_resolve(tailscaled_t)

# client side
allow staff_t tailscaled_runtime_t:dir search;
allow staff_t tailscaled_runtime_t:sock_file { getattr write };
allow staff_t tailscaled_t:unix_stream_socket connectto;

#============= tailscaled_t ==============
allow tailscaled_t NetworkManager_etc_rw_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t NetworkManager_etc_rw_t:file getattr;
allow tailscaled_t NetworkManager_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t alsa_etc_t:dir { getattr open read search watch watch_reads };
allow tailscaled_t auditd_etc_t:dir { getattr open read search watch watch_reads };
