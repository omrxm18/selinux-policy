/nix                                               gen_context(system_u:object_r:usr_t,s0 )
/nix/store                                         gen_context(system_u:object_r:lib_t,s0 )
/nix/store/[^/]+/bin(/.*)?                         gen_context(system_u:object_r:bin_t,s0 )
/nix/store/[^/]+/lib(/.*)?                         gen_context(system_u:object_r:lib_t,s0 )
/nix(/.*)?                                         gen_context(system_u:object_r:usr_t,s0 )

/usr/bin/plasmalogin                               gen_context(system_u:object_r:xdm_exec_t,s0 )
/var/lib/plasmalogin(/.*)?                         gen_context(system_u:object_r:xdm_var_lib_t,s0 )
/run/plasmalogin(/.*)?                             gen_context(system_u:object_r:xdm_var_run_t,s0 )
/usr/share/plasmalogin/scripts/wayland-session     gen_context(system_u:object_r:xsession_exec_t,s0 )

/usr/bin/xdg-open                              --  gen_context(system_u:object_r:xdg_open_exec_t,s0)
/nix/store/[^/]+-xdg-utils-[^/]+/bin/xdg-open  --  gen_context(system_u:object_r:xdg_open_exec_t,s0)
/run/current-system/sw/bin/xdg-open            --  gen_context(system_u:object_r:xdg_open_exec_t,s0)