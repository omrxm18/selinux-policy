policy_module(extensions, 1.0)

gen_require(`
    type auditd_t;
    type bluetooth_t;
    type cupsd_t;
    type devicekit_disk_t;
    type dnsmasq_t;
    type gpg_t;
    type ifconfig_t;
    type init_t;
    type initrc_t;
    type kmod_t;
    type lvm_t;
    type NetworkManager_t;
    type ntpd_t;
    type pipewire_t;
    type plymouth_t;
    type plymouthd_t;
    type policykit_t;
    type semanage_t;
    type staff_dbusd_t;
    type staff_t;
    type sysadm_t;
    type syslogd_t;
    type udev_t;
    type utempter_t;
    type alsa_var_lib_t;
    type auditd_etc_t;
    type autofs_t;
    type bin_t;
    type binfmt_misc_fs_t;
    type boot_t;
    type bpf_t;
    type cert_t;
    type cgroup_t;
    type chkpwd_t;
    type chromium_xdg_config_t;
    type configfs_t;
    type container_conf_home_t;
    type container_runtime_t;
    type debugfs_t;
    type device_t;
    type devpts_t;
    type efivarfs_t;
    type etc_runtime_t;
    type evolution_xdg_config_t;
    type exports_t;
    type fonts_t;
    type fuse_device_t;
    type fusefs_t;
    type git_xdg_config_t;
    type gnome_xdg_config_t;
    type gnome_xdg_data_t;
    type gpg_agent_tmp_t;
    type gpg_runtime_t;
    type gpg_secret_t;
    type gpg_pinentry_t;
    type staff_wm_t;
    type home_root_t;
    type http_port_t;
    type hugetlbfs_t;
    type i2c_device_t;
    type init_var_lib_t;
    type initrc_runtime_t;
    type java_home_t;
    type krb5_conf_t;
    type mesa_shader_cache_t;
    type mnt_t;
    type mount_exec_t;
    type mount_runtime_t;
    type mozilla_home_t;
    type mozilla_xdg_cache_t;
    type mplayer_xdg_config_t;
    type mplayer_xdg_data_t;
    type net_conf_t;
    type nsfs_t;
    type pstore_t;
    type pulseaudio_tmp_t;
    type pulseaudio_xdg_config_t;
    type restorecond_exec_t;
    type root_t;
    type samba_etc_t;
    type samba_net_exec_t;
    type samba_var_t;
    type selinux_config_t;
    type shadow_t;
    type ssh_home_t;
    type staff_sudo_t;
    type swapfile_t;
    type sysctl_net_t;
    type syslogd_runtime_t;
    type systemd_coredump_var_lib_t;
    type systemd_journal_t;
    type systemd_logind_inhibit_runtime_t;
    type systemd_logind_runtime_t;
    type systemd_machined_t;
    type systemd_machined_runtime_t;
    type systemd_unit_t;
    type systemd_user_runtime_t;
    type systemd_user_tmpfs_t;
    type systemd_userdbd_runtime_t;
    type tmp_t;
    type tmpfs_t;
    type tracefs_t;
    type udev_runtime_t;
    type user_cert_t;
    type user_home_dir_t;
    type user_home_t;
    type user_runtime_t;
    type usr_t;
    type utempter_exec_t;
    type var_lib_t;
    type var_log_t;
    type virt_var_lib_t;
    type wm_tmpfs_t;
    type xdm_var_lib_t;
    type session_dbusd_runtime_t;
    type xdm_t;
    type xdm_var_run_t;
    type staff_systemd_t;
    type system_dbusd_t;
    type user_dbusd_t;
    type systemd_userdbd_t;
    type user_systemd_t;
    type xdg_cache_t;
    type xdg_config_t;
    type xdg_data_t;
    type xdg_pictures_t;
    type systemd_user_unit_t;
    type default_t;
    type git_home_t;

    class capability setuid;
    class capability2 { checkpoint_restore perfmon };
    class chr_file { getattr ioctl lock open read write };
    class dir { add_name create getattr ioctl lock mounton open read remove_name rmdir search watch write };
    class fd use;
    class system { start status };
    class service { start status };
    class fifo_file { getattr write };
    class dbus send_msg;
    class file { create entrypoint execute execute_no_trans getattr ioctl link lock map open read rename setattr unlink watch write relabelfrom relabelto };
    class filesystem { getattr mount quotaget quotamod };
    class lnk_file { getattr read };
    class netlink_route_socket { read write };
    class netlink_kobject_uevent_socket { getattr read write setopt getopt bind create };
    class process { execmem setsched transition };
    class shm { create destroy read unix_read };
    class sock_file { create getattr read unlink write };
    class tcp_socket { connect create getattr getopt name_connect read setopt write };
    class unix_stream_socket { bind connectto create getattr ioctl listen read setattr setopt write };
')

#============= auditd_t ==============
allow auditd_t systemd_machined_t:unix_stream_socket connectto;
allow auditd_t systemd_userdbd_runtime_t:sock_file read;

#============= bluetooth_t ==============
allow bluetooth_t udev_runtime_t:dir search;
allow bluetooth_t udev_runtime_t:lnk_file read;
init_dbus_chat(bluetooth_t)


#============= pipewire_t ==============
allow pipewire_t xdm_var_lib_t:dir search;
allow pipewire_t xdm_var_run_t:dir search;

#============= cupsd_t ==============
allow cupsd_t init_t:dbus send_msg;
allow cupsd_t systemd_machined_t:unix_stream_socket connectto;
allow cupsd_t systemd_userdbd_runtime_t:sock_file read;

#============= dnsmasq_t ==============
allow dnsmasq_t container_runtime_t:dir { add_name search write };
allow dnsmasq_t container_runtime_t:file { create open setattr write };
allow dnsmasq_t systemd_machined_t:unix_stream_socket connectto;
allow dnsmasq_t systemd_userdbd_runtime_t:sock_file read;

allow semanage_t selinux_config_t:file { relabelfrom relabelto };

#============= gpg_t ==============
allow gpg_t tmp_t:file { open read };

#============= ifconfig_t ==============
allow ifconfig_t selinux_config_t:lnk_file read;

#============= init_t ==============
allow init_t self:capability2 checkpoint_restore;
allow init_t self:process execmem;

#============= initrc_t ==============
allow initrc_t self:process execmem;
allow initrc_t sysadm_t:process transition;

#============= kmod_t ==============
allow kmod_t initrc_runtime_t:file { read write };
allow kmod_t self:capability2 perfmon;

#============= lvm_t ==============
# /dev/mapper/control can still be device_t when lvm starts, before udev
# has applied lvm_control_t.
allow lvm_t device_t:chr_file { getattr ioctl open read write };

#============= ntpd_t ==============
allow ntpd_t sysctl_net_t:dir search;
allow ntpd_t sysctl_net_t:file { getattr open read };

#============= pipewire_t ==============
allow pipewire_t alsa_var_lib_t:dir search;
allow pipewire_t pulseaudio_tmp_t:dir { add_name write };
allow pipewire_t pulseaudio_tmp_t:file { create getattr open write };
allow pipewire_t selinux_config_t:lnk_file read;

#============= plymouth_t ==============
allow plymouth_t init_t:unix_stream_socket connectto;

#============= plymouthd_t ==============
allow plymouthd_t self:netlink_kobject_uevent_socket { getattr read write setopt getopt bind create };

#============= policykit_t ==============
allow policykit_t selinux_config_t:lnk_file read;
allow policykit_t systemd_userdbd_runtime_t:sock_file read;
allow policykit_t staff_systemd_t:dbus send_msg;
systemd_get_user_manager_units_status(policykit_t)

#============= semanage_t ==============
allow semanage_t staff_t:fifo_file { getattr write };

#============= system_dbusd_t ==============
init_get_system_status(system_dbusd_t)

#============== gpg_* ==============
allow gpg_t self:unix_stream_socket connectto;
allow gpg_pinentry_t staff_wm_t:unix_stream_socket connectto;
allow gpg_pinentry_t gpg_t:dir search;
allow gpg_pinentry_t xdg_config_t:file { getattr open read };
allow gpg_pinentry_t user_home_t:lnk_file read;
allow gpg_pinentry_t user_home_t:dir search;
allow gpg_pinentry_t self:process execmem;
allow gpg_pinentry_t etc_runtime_t:file read;
allow gpg_pinentry_t gnome_xdg_config_t:dir search;
allow gpg_pinentry_t session_dbusd_runtime_t:sock_file write;
allow gpg_pinentry_t etc_runtime_t:file open;

#============= devicekit_disk_t ==============
allow devicekit_disk_t staff_systemd_t:dbus send_msg;

#============= NetworkManager_t ==============
allow NetworkManager_t staff_systemd_t:dbus send_msg;
allow NetworkManager_t user_systemd_t:dbus send_msg;
allow NetworkManager_t xdg_cache_t:dir search;

#============= sysadm_t ==============
allow sysadm_t self:process execmem;
allow sysadm_t staff_dbusd_t:unix_stream_socket connectto;
allow sysadm_t usr_t:file entrypoint;

#============= syslogd_t ==============
allow syslogd_t systemd_unit_t:dir search;
allow syslogd_t systemd_unit_t:lnk_file read;
allow syslogd_t tmpfs_t:dir search;

#============= udev_t ==============
allow udev_t self:capability2 perfmon;

#============= policykit_t ==============
allow policykit_t etc_runtime_t:file { open read };
allow policykit_t systemd_unit_t:service status;

#============= utempter_t ==============
allow utempter_t staff_systemd_t:fd use;
allow utempter_t staff_systemd_t:unix_stream_socket { getattr read write };

allow { NetworkManager_t auditd_t chkpwd_t pipewire_t policykit_t staff_t staff_sudo_t
            systemd_userdbd_t user_dbusd_t user_systemd_t } xdm_t:unix_stream_socket connectto;