module extensions 1.0;

require {
    type auditd_t;
    type bluetooth_t;
    type cupsd_t;
    type dnsmasq_t;
    type gpg_t;
    type ifconfig_t;
    type init_t;
    type initrc_t;
    type kmod_t;
    type ntpd_t;
    type pipewire_t;
    type plymouth_t;
